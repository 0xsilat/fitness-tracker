package web

import (
	"fmt"
	"time"
	"github.com/local/fitness-tracker/internal/domain"
)

templ Layout(title string) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Tempo</title>
			<link rel="stylesheet" href="/static/app.css?v=20260830-server-emom"/>
			<script src="https://unpkg.com/htmx.org@2.0.4" integrity="sha384-HGfztofotkmshcpmSSjZ2fLJm8aTTpYo804Arnaaj5i9IF40ZBrAqBBZJNGbc/HP" crossorigin="anonymous"></script>
			<script src="/static/app.js?v=20260830-server-emom" defer></script>
		</head>
		<body>
			<header class="site-header">
				<a class="brand" href="/"><span class="brand-mark">T</span><span>Tempo</span></a>
				<nav aria-label="Primary">
					<a href="/">Home</a><a href="/routines">Routines</a><a href="/exercises">Exercises</a><a href="/analytics">Analytics</a><a href="/sessions">Log</a>
				</nav>
			</header>
			<main class="page">{ children... }</main>
			<footer><span>Tempo fitness tracker</span><a href="/about">About</a></footer>
		</body>
	</html>
}

templ PageHeader(eyebrow,title,description string) {
	<div class="page-heading"><div><p class="eyebrow">{ eyebrow }</p><h1>{ title }</h1><p class="lede">{ description }</p></div>{ children... }</div>
}

templ EmptyState(title,text string) { <div class="empty"><span class="empty-icon">↗</span><h2>{ title }</h2><p>{ text }</p>{ children... }</div> }

templ DashboardPage(d domain.Dashboard) {
	@Layout("Home") {
		@PageHeader("Training overview","Home","Your completed-session consistency over the last year.") { <a class="button primary" href="/sessions?new=1">Log workout</a> }
		<div class="metric-grid home-metrics">
			<div class="metric accent"><span>Last 7 days</span><strong>{ fmt.Sprintf("%d",d.SessionCount7) }</strong><small>completed sessions</small></div>
			<div class="metric"><span>Last 30 days</span><strong>{ fmt.Sprintf("%d",d.SessionCount30) }</strong><small>completed sessions</small></div>
			<div class="metric"><span>Last 90 days</span><strong>{ fmt.Sprintf("%d",d.SessionCount90) }</strong><small>completed sessions</small></div>
		</div>
		<section class="panel activity-panel">
			<div class="section-title"><div><h2>Training consistency</h2><p class="muted">Completed sessions in the last 365 days</p></div><div class="activity-legend" aria-label="Activity intensity"><span>Less</span><i class="level-0"></i><i class="level-1"></i><i class="level-2"></i><i class="level-3"></i><span>More</span></div></div>
			@ActivityCalendar(d.Activity)
		</section>
		if len(d.Drafts) > 0 {
			<section><div class="section-title"><h2>Draft sessions</h2><a href="/sessions">View log</a></div><div class="session-list">
				for _, x := range d.Drafts {
					@SessionRow(x)
				}
			</div></section>
		}
	}
}

templ ActivityCalendar(days []domain.ActivityDay) {
	<div class="activity-scroll" data-scroll-end tabindex="0" aria-label="Training activity calendar">
		<div class="activity-calendar">
			<div class="activity-months" style={ fmt.Sprintf("grid-template-columns:repeat(%d,12px)",activityWeekCount(days)) } aria-hidden="true">
				for _, marker := range activityMonthMarkers(days) {
					<span style={ fmt.Sprintf("grid-column:%d / span 3",marker.Column) }>{ marker.Label }</span>
				}
			</div>
			<div class="activity-grid">
				if activityOffset(days) > 0 {
					<span class="activity-offset" style={ fmt.Sprintf("grid-row:span %d",activityOffset(days)) }></span>
				}
				for _, day := range days {
					<span class={ activityLevel(day.Sessions) } title={ activityLabel(day) } aria-label={ activityLabel(day) }></span>
				}
			</div>
		</div>
	</div>
}

templ SessionRow(x domain.Session) { <a class="session-row" href={ templ.SafeURL(fmt.Sprintf("/sessions/%d",x.ID)) }><span class="session-row-title"><strong>{ x.WorkoutName }</strong><small>{ fmt.Sprintf("%d sets done",x.CompletedSets) }</small></span><time datetime={ inputDate(x.PerformedOn) }>{ date(x.PerformedOn) }</time><span class={ "status "+x.Status }>{ x.Status }</span><span class="row-chevron" aria-hidden="true">›</span></a> }

templ ExercisesPage(items []domain.Exercise,showArchived bool) {
	@Layout("Exercises") {
		@PageHeader("Library","Exercises","Shared exercise records keep progress connected across every routine.") { <a class="button secondary" href="#add-exercise">Add exercise</a> }
		<details id="add-exercise" class="disclosure" open?={ len(items)==0 }><summary class="disclosure-summary">Add an exercise <span>+</span></summary><div class="disclosure-body"><form class="stack compact-form" method="post" action="/exercises"><label>Name<input name="name" required placeholder="e.g. Bulgarian split squat"/></label><label>Tracking<select name="mode"><option value="weighted">Weighted</option><option value="bodyweight">Bodyweight</option></select></label><button class="button primary">Add exercise</button></form></div></details>
		<section>
				<div class="section-title"><h2>Your library</h2>
					if showArchived {
						<a href="/exercises">Hide archived</a>
					} else {
						<a href="/exercises?archived=1">Show archived</a>
					}
				</div>
				<div class="table-wrap"><table><thead><tr><th>Exercise</th><th>Tracking</th><th>Progress</th><th></th></tr></thead><tbody>
					for _, x := range items {
						<tr><td><strong>{ x.Name }</strong>
							if x.Archived {
								<span class="pill">Archived</span>
							}
						</td><td>{ x.Mode }</td><td><a href={ templ.SafeURL(fmt.Sprintf("/analytics/exercises/%d",x.ID)) }>Analytics</a></td><td>
							if !x.Archived {
								<form method="post" action={ fmt.Sprintf("/exercises/%d/archive",x.ID) }><button class="text-button">Archive</button></form>
							}
						</td></tr>
					}
				</tbody></table></div>
		</section>
	}
}

templ RoutinesPage(items []domain.Routine) {
	@Layout("Routines") {
		@PageHeader("Programming","Routines","Build ordered workout days and choose one routine as your current focus.") { <a class="button secondary" href="#add-routine">New routine</a> }
		<details id="add-routine" class="disclosure" open?={ len(items)==0 }><summary class="disclosure-summary">Create a routine <span>+</span></summary><div class="disclosure-body"><form class="stack compact-form" method="post" action="/routines"><label>Name<input name="name" required placeholder="e.g. Three-day strength"/></label><label>Description<textarea name="description" rows="2" placeholder="What is this block for?"></textarea></label><button class="button primary">Create routine</button></form></div></details>
		<section><div class="routine-grid">
				if len(items) == 0 {
					<p class="muted">No routines yet.</p>
				}
				for _, r := range items {
					<a class={ routineClass(r) } href={ templ.SafeURL(fmt.Sprintf("/routines/%d",r.ID)) }><div><span class="status">{ routineStatus(r) }</span><h2>{ r.Name }</h2><p>{ r.Description }</p></div><strong>{ fmt.Sprintf("%d",r.WorkoutCount) } <small>days</small></strong></a>
				}
		</div></section>
	}
}

templ RoutinePage(r domain.Routine,workouts []domain.Workout) {
	@Layout(r.Name) {
		<a class="back" href="/routines">← All routines</a>
		@PageHeader("Routine",r.Name,r.Description) {
			<div class="actions">
				if !r.Active {
					<form method="post" action={ fmt.Sprintf("/routines/%d/activate",r.ID) }><button class="button primary">Make active</button></form>
				}
				<a class="button secondary" href={ templ.SafeURL(fmt.Sprintf("/analytics/routines/%d",r.ID)) }>Analytics</a>
			</div>
		}
		<section><div class="section-title"><h2>Workout days</h2><span>{ fmt.Sprintf("%d",len(workouts)) } total</span></div><div class="workout-list">
				if len(workouts) == 0 {
					<p class="muted">Add your first workout day.</p>
				}
				for _, w := range workouts {
					<div class="workout-row"><span class="day-number">{ fmt.Sprintf("%02d",w.Position) }</span><a class="grow" href={ templ.SafeURL(fmt.Sprintf("/workouts/%d",w.ID)) }><strong>{ w.Name }</strong><small>{ fmt.Sprintf("%d exercise blocks · mixed formats",len(w.Prescription.Movements)) }</small></a><form class="inline" method="post" action={ fmt.Sprintf("/workouts/%d/move",w.ID) }><button class="icon-button" name="direction" value="up" aria-label="Move up">↑</button><button class="icon-button" name="direction" value="down" aria-label="Move down">↓</button></form><form method="post" action={ fmt.Sprintf("/workouts/%d/delete",w.ID) } onsubmit="return confirm('Delete this workout day? Completed sessions will be kept.')"><button class="icon-button danger" aria-label="Delete workout day" title="Delete workout day">×</button></form></div>
				}
		</div></section>
		<details class="disclosure" open?={ len(workouts)==0 }><summary class="disclosure-summary">Add workout day <span>+</span></summary><div class="disclosure-body"><form class="stack compact-form" method="post" action={ fmt.Sprintf("/routines/%d/workouts",r.ID) }><label>Name<input name="name" required placeholder="e.g. Lower A"/></label><small>Exercise formats are selected when you add each exercise.</small><button class="button primary">Add workout</button></form></div></details>
		<div class="page-actions"><form method="post" action={ fmt.Sprintf("/routines/%d/duplicate",r.ID) }><button class="button secondary">Duplicate routine</button></form>
			if !r.Archived {
				<form method="post" action={ fmt.Sprintf("/routines/%d/archive",r.ID) } onsubmit="return confirm('Archive this routine?')"><button class="text-button danger">Archive routine</button></form>
			}
		</div>
	}
}

templ WorkoutPage(r domain.Routine,w domain.Workout,exercises []domain.Exercise) {
	@Layout(w.Name) {
		<a class="back" href={ templ.SafeURL(fmt.Sprintf("/routines/%d",r.ID)) }>← { r.Name }</a>
		@PageHeader(fmt.Sprintf("Day %d · Mixed formats",w.Position),w.Name,"Choose a format for each exercise block; EMOM and sets × reps can live in the same workout.") {
			if len(w.Prescription.Movements) > 0 {
				<a class="button primary" href={ templ.SafeURL(fmt.Sprintf("/sessions?new=1&workout_id=%d",w.ID)) }>Log workout</a>
			}
		}
		<section><div class="section-title"><h2>Exercise blocks</h2><span>{ fmt.Sprintf("%d total",len(w.Prescription.Movements)) }</span></div><div class="movement-list">
				if len(w.Prescription.Movements) == 0 {
					@EmptyState("No exercises yet","Use the form to build this workout.") {}
				}
				for i, m := range w.Prescription.Movements {
					<article class="movement compact-movement"><div class="movement-head"><div><span class="eyebrow">Exercise { fmt.Sprintf("%02d",i+1) } · { formatName(m.Format) }</span><h3>{ m.ExerciseName }</h3><small>{ m.Mode }
						if m.Format == "emom" {
							<span> · { fmt.Sprintf("%d minutes",m.DurationMinutes) }</span>
						}
					</small></div><form method="post" action={ fmt.Sprintf("/workouts/%d/movements/%d/remove",w.ID,i) }><button class="text-button danger">Remove</button></form></div><details class="movement-plan"><summary>{ fmt.Sprintf("%d planned entries",len(m.Sets)) } <span>Show details</span></summary><div class="set-chips">
						for _, set := range m.Sets {
							<span>
								if m.Format == "emom" {
									<span>Min { fmt.Sprintf("%d",set.Minute) } · </span>
								}
								if set.Reps > 0 {
									<span>Target { fmt.Sprintf("%d reps",set.Reps) }</span>
								} else {
									<span>Open reps</span>
								}
								if m.Mode == "weighted" {
									<span> · { number(set.WeightKG) } kg</span>
								}
							</span>
						}
					</div></details></article>
				}
		</div></section>
		<details class="disclosure" open?={ len(w.Prescription.Movements)==0 }><summary class="disclosure-summary">Add exercise block <span>+</span></summary><div class="disclosure-body"><form class="stack compact-form" data-format-form method="post" action={ fmt.Sprintf("/workouts/%d/movements",w.ID) }><div class="form-grid"><label>Exercise<select name="exercise_id">
				for _, x := range exercises {
					<option value={ fmt.Sprintf("%d",x.ID) }>{ x.Name } · { x.Mode }</option>
				}
			</select></label><label>Format<select name="format" data-format-select aria-controls="sets-fields emom-fields"><option value="sets_reps">Sets × reps</option><option value="emom">EMOM</option></select></label><label>Target reps <span class="optional">Optional</span><input name="target_reps" type="number" inputmode="numeric" min="1" placeholder="Open reps"/></label><label>Planned weight (kg) <span class="optional">Optional</span><input name="weight" type="number" inputmode="decimal" min="0" step="0.25" placeholder="0"/></label></div><div id="sets-fields" data-format-fields="sets_reps"><label>Number of sets<input name="sets" type="number" inputmode="numeric" min="1" value="3"/></label></div><fieldset id="emom-fields" class="emom-fields" data-format-fields="emom"><legend>EMOM structure</legend><label>Duration (minutes)<input name="duration" type="number" inputmode="numeric" min="1" value="10"/></label><label>Starting minute<input name="start_minute" type="number" inputmode="numeric" min="1" value="1"/></label><label>Repeat every (minutes)<input name="interval_minutes" type="number" inputmode="numeric" min="1" value="1"/></label></fieldset>
				<button class="button primary">Add to workout</button></form></div></details>
	}
}

templ SessionsPage(items []domain.Session,groups []domain.WorkoutGroup,showNewForm bool,selectedWorkoutID int64,performedOn time.Time) {
	@Layout("Log workouts") {
		@PageHeader("Training log","Log workouts","Add a workout entry, then review your complete training history.") { <a class="button primary" href="/sessions?new=1">Add new workout</a> }
		if showNewForm {
			<section class="panel session-start"><div class="section-title"><h2>Add new workout</h2><a href="/sessions">Cancel</a></div><form class="stack" method="post" action="/sessions"><label>Workout<select name="workout_id" required><option value="">Choose a workout</option>
				for _, group := range groups {
					<optgroup label={ routineLogLabel(group.Routine) }>
						for _, workout := range group.Workouts {
							<option value={ fmt.Sprintf("%d",workout.ID) } selected?={ workout.ID == selectedWorkoutID }>{ workout.Name }</option>
						}
					</optgroup>
				}
			</select></label><label>Date performed<input name="performed_on" type="date" value={ inputDate(performedOn) } required/></label><button class="button primary">Start logging</button></form></section>
		}
		<section><div class="section-title"><h2>Log history</h2><span>{ fmt.Sprintf("%d",len(items)) } entries</span></div><div class="session-list">
			if len(items) == 0 {
				<p class="muted">No workout entries yet.</p>
			}
			for i, x := range items {
				if startsSessionMonth(items,i) {
					<div class="session-month-divider"><span>{ sessionMonth(x.PerformedOn) }</span></div>
				}
				@SessionRow(x)
			}
		</div></section>
	}
}

templ SessionPage(s domain.Session,exercises []domain.SessionExercise,editing bool) {
	@SessionPageWithState(s,exercises,editing,nil)
}

templ SessionPageWithState(s domain.Session,exercises []domain.SessionExercise,editing bool,states map[int64]emomEntryState) {
	@Layout(s.WorkoutName) {
		<a class="back" href="/sessions">← Log workouts</a>
		@PageHeader(s.RoutineName,s.WorkoutName,formatName(s.Format)+" · Performed "+date(s.PerformedOn)) {
			<span class={ "status "+s.Status }>{ s.Status }</span>
			@SessionSetCount(s.CompletedSets,false)
			if s.Status == "completed" && !editing {
				<a class="button secondary" href={ templ.SafeURL(fmt.Sprintf("/sessions/%d?edit=1",s.ID)) }>Edit entry</a>
			}
		}
		if s.Status=="draft" {
			<form id="session-form" class="session-form" method="post" action={ fmt.Sprintf("/sessions/%d/save",s.ID) } hx-post={ fmt.Sprintf("/sessions/%d/save",s.ID) } hx-trigger="submit" hx-target="#save-status" hx-swap="outerHTML" hx-sync="#session-form:queue all" hx-disabled-elt="#session-fields">
				<fieldset id="session-fields" class="session-fields" hx-post={ fmt.Sprintf("/sessions/%d/save",s.ID) } hx-trigger="change[event.target.form && event.target.form.id === 'session-form'] delay:500ms" hx-validate="true">
				<div class="panel session-draft-date"><label>Date performed<input name="performed_on" type="date" value={ inputDate(s.PerformedOn) } required/></label></div>
				@SessionExercisesWithState(exercises,true,true,states)
				<div class="panel session-notes"><label>Session notes<textarea name="notes" rows="4" placeholder="How did it feel?">{ s.Notes }</textarea></label><label>Effort (RPE)<input name="rpe" type="number" min="1" max="10" value={ rpeValue(s.RPE) } placeholder="1–10"/></label></div>
				<div class="sticky-actions"><span id="save-status" class="save-status">Draft autosaves</span><button class="button secondary" type="submit">Save draft</button><button class="button primary" type="submit" formaction={ fmt.Sprintf("/sessions/%d/complete",s.ID) } hx-post={ fmt.Sprintf("/sessions/%d/complete",s.ID) }>Complete workout</button></div>
				</fieldset>
			</form>
			<form method="post" action={ fmt.Sprintf("/sessions/%d/discard",s.ID) } onsubmit="return confirm('Discard this draft?')"><button class="text-button danger">Discard draft</button></form>
		} else if editing {
			<form id="session-form" class="session-form" method="post" action={ fmt.Sprintf("/sessions/%d/update",s.ID) } hx-post={ fmt.Sprintf("/sessions/%d/update",s.ID) } hx-sync="#session-form:queue all" hx-disabled-elt="#session-fields">
				<fieldset id="session-fields" class="session-fields">
				<div class="panel session-edit-details"><label>Date performed<input name="performed_on" type="date" value={ inputDate(s.PerformedOn) } required/></label><label>Session notes<textarea name="notes" rows="4" placeholder="How did it feel?">{ s.Notes }</textarea></label><label>Effort (RPE)<input name="rpe" type="number" min="1" max="10" value={ rpeValue(s.RPE) } placeholder="1–10"/></label></div>
				@SessionExercisesWithState(exercises,true,false,states)
				<div class="sticky-actions"><a class="button secondary" href={ templ.SafeURL(fmt.Sprintf("/sessions/%d",s.ID)) }>Cancel</a><button class="button primary" type="submit">Save changes</button></div>
				</fieldset>
			</form>
		} else {
			@SessionExercises(exercises,false,false)
			if s.Notes != "" || s.RPE != nil {
				<section class="panel"><h2>Notes</h2><p>{ s.Notes }</p>
					if s.RPE != nil {
						<p><strong>RPE { fmt.Sprintf("%d",*s.RPE) }/10</strong></p>
					}
				</section>
			}
			<form method="post" action={ fmt.Sprintf("/sessions/%d/delete",s.ID) } onsubmit="return confirm('Permanently delete this completed session?')"><button class="text-button danger">Delete session</button></form>
		}
		if s.Status == "draft" || editing {
			@EMOMForms(exercises)
			<noscript><style>.emom-quick { display: none; }</style></noscript>
		}
	}
}

templ SessionExercises(exercises []domain.SessionExercise,editable bool,addable bool) {
	@SessionExercisesWithState(exercises,editable,addable,nil)
}

templ SessionExercisesWithState(exercises []domain.SessionExercise,editable bool,addable bool,states map[int64]emomEntryState) {
	<div class="movement-list">
		for _, e := range exercises {
			@SessionExercise(e,editable,addable,emomStateFor(e,states))
		}
	</div>
}

templ SessionExercise(e domain.SessionExercise,editable bool,addable bool,state emomEntryState) {
			<article id={ fmt.Sprintf("exercise-%d",e.ID) } class="movement"><div class="movement-head"><div><span class="eyebrow">{ formatName(e.Format) }</span><h2>{ e.Name }</h2><small>{ e.Mode }
				if e.Format == "emom" {
					if addable {
						<span> · { fmt.Sprintf("%d planned minutes",e.DurationMinutes) }</span>
					} else {
						<span> · { fmt.Sprintf("%d minutes done",completedExerciseSets(e)) }</span>
					}
				}
			</small></div>
				if addable {
					<button class="button ghost" type="submit" formaction={ fmt.Sprintf("/sessions/%d/sets",e.SessionID) } hx-post={ fmt.Sprintf("/sessions/%d/sets",e.SessionID) } hx-target="closest .movement" hx-swap="outerHTML show:none settle:0" name="session_exercise_id" value={ fmt.Sprintf("%d",e.ID) }>+ Set</button>
				}
			</div>
			@SessionMinuteEditor(e,editable,addable,state) {
			<div class="set-table"><div class={ sessionHeaderClass(e.Mode,editable && len(e.Sets)>1) }>
				if e.Format == "emom" {
					<span>Minute</span>
				} else {
					<span>Set</span>
				}
				<span>Actual reps</span>
				if e.Mode == "weighted" {
					<span>Weight</span>
				}
				<span>Skip</span>
				if editable && len(e.Sets)>1 {
					<span class="visually-hidden">Delete</span>
				}
			</div>
				for _, set := range e.Sets {
					<div class={ sessionRowClass(e.Mode,set.Skipped,editable && len(e.Sets)>1) }><strong>{ setMarker(e.Format,set) }</strong>
						if editable {
							<label class="actual-input"><input id={ fmt.Sprintf("reps_%d",set.ID) } aria-label="Actual reps" name={ fmt.Sprintf("reps_%d",set.ID) } type="number" inputmode="numeric" min="0" value={ actualRepsValue(set.Reps) } placeholder="Reps"/>
								if set.TargetReps != nil {
									<small>Target { fmt.Sprintf("%d",*set.TargetReps) }</small>
								}
							</label>
							if e.Mode == "weighted" {
								<label class="weight-input"><input id={ fmt.Sprintf("weight_%d",set.ID) } aria-label="Weight in kilograms" name={ fmt.Sprintf("weight_%d",set.ID) } type="number" min="0" step="0.25" value={ number(set.WeightKG) }/><span>kg</span></label>
							}
							<input aria-label="Skip set" name={ fmt.Sprintf("skipped_%d",set.ID) } type="checkbox" checked?={ set.Skipped }/>
							if len(e.Sets)>1 {
								<button class="icon-button danger set-delete" type="submit" aria-label={ fmt.Sprintf("Delete set %d",set.Position) } title="Delete set" formaction={ fmt.Sprintf("/sessions/%d/sets/%d/delete",e.SessionID,set.ID) } hx-post={ fmt.Sprintf("/sessions/%d/sets/%d/delete",e.SessionID,set.ID) } hx-target="closest .movement" hx-swap="outerHTML show:none settle:0">×</button>
							}
						} else {
							<span>{ fmt.Sprintf("%d",set.Reps) }</span>
							if e.Mode == "weighted" {
								<span>{ number(set.WeightKG) } kg</span>
							}
							if set.Skipped {
								<span>Skipped</span>
							} else {
								<span>Done</span>
							}
						}
					</div>
				}
			</div>
			}
			</article>
}

templ SessionMinuteEditor(e domain.SessionExercise,editable bool,addable bool,state emomEntryState) {
	if editable && e.Format == "emom" {
		<div data-emom-editor>
			<div id={ fmt.Sprintf("emom-quick-%d",e.ID) } class="emom-quick"
				if state.PreserveQuick {
					hx-preserve="true"
				}
			>
				<div class="emom-quick-fields">
					<label>Reps per minute<input id={ fmt.Sprintf("emom_reps_%d",e.ID) } name={ fmt.Sprintf("emom_reps_%d",e.ID) } form={ fmt.Sprintf("emom-form-%d",e.ID) } type="number" inputmode="numeric" min="1" step="1" required placeholder="Reps" value={ state.Reps }/></label>
					if e.Mode == "weighted" {
						<label>Weight (kg) <span class="optional">Optional</span><input id={ fmt.Sprintf("emom_weight_%d",e.ID) } name={ fmt.Sprintf("emom_weight_%d",e.ID) } form={ fmt.Sprintf("emom-form-%d",e.ID) } type="number" inputmode="decimal" min="0" step="0.25" placeholder="Keep existing weights" value={ state.Weight }/></label>
					}
					<button type="submit" form={ fmt.Sprintf("emom-form-%d",e.ID) } name="emom_action" value="apply" class="button secondary">Apply to all minutes</button>
				</div>
				<p class="muted">Applies to this exercise only. Skipped minutes stay unchanged.</p>
				if state.Confirm {
				<div class="emom-confirm">
					<p>Existing reps or weights differ. Replace values in all non-skipped minutes, including individual exceptions?</p>
					<button type="submit" form={ fmt.Sprintf("emom-form-%d",e.ID) } name="emom_action" value="confirm" class="button secondary">Replace values</button>
					<button type="submit" form={ fmt.Sprintf("emom-form-%d",e.ID) } name="emom_action" value="cancel" formnovalidate class="button ghost">Cancel</button>
				</div>
				}
				<p class="emom-feedback" role="status" aria-live="polite">{ state.Message }</p>
			</div>
			<div class="emom-details">
				<input type="hidden" name={ fmt.Sprintf("emom_present_%d",e.ID) } value="1"/>
				<input class="emom-toggle" type="checkbox" id={ fmt.Sprintf("emom-open-%d",e.ID) } name={ fmt.Sprintf("emom_open_%d",e.ID) } checked?={ state.Open } aria-controls={ fmt.Sprintf("emom-rows-%d",e.ID) }/>
				<label class="emom-summary" for={ fmt.Sprintf("emom-open-%d",e.ID) }>
					Edit individual minutes
					@EMOMSummary(e,false)
				</label>
				<div id={ fmt.Sprintf("emom-rows-%d",e.ID) } class="emom-minute-rows">
					if !addable {
						<div hx-post={ fmt.Sprintf("/sessions/%d/exercises/%d/emom",e.SessionID,e.ID) } hx-vals='{"emom_action":"summary"}' hx-trigger="change delay:500ms" hx-target={ fmt.Sprintf("#emom-summary-%d",e.ID) } hx-swap="outerHTML" hx-sync="#session-form:queue all">
							{ children... }
						</div>
					} else {
						{ children... }
					}
				</div>
			</div>
		</div>
	} else {
		{ children... }
	}
}

templ EMOMForms(exercises []domain.SessionExercise) {
	for _, e := range exercises {
		if e.Format == "emom" {
			<form id={ fmt.Sprintf("emom-form-%d",e.ID) } method="post" action={ fmt.Sprintf("/sessions/%d/exercises/%d/emom",e.SessionID,e.ID) } hx-post={ fmt.Sprintf("/sessions/%d/exercises/%d/emom",e.SessionID,e.ID) } hx-include="#session-form" hx-target={ fmt.Sprintf("#exercise-%d",e.ID) } hx-swap="outerHTML show:none settle:0" hx-sync="#session-form:queue all" hx-disabled-elt="#session-fields" hidden></form>
		}
	}
}

templ EMOMSummary(e domain.SessionExercise,outOfBand bool) {
	if outOfBand {
		<span id={ fmt.Sprintf("emom-summary-%d",e.ID) } hx-swap-oob="true">{ emomSummary(e) }</span>
	} else {
		<span id={ fmt.Sprintf("emom-summary-%d",e.ID) }>{ emomSummary(e) }</span>
	}
}

templ SessionExerciseUpdate(e domain.SessionExercise,state emomEntryState,draft bool,completedSets int,saved bool) {
	@SessionExercise(e,true,draft,state)
	@SessionSetCount(completedSets,true)
	if saved {
		<span id="save-status" class="save-status saved" hx-swap-oob="true">Saved just now</span>
	}
}

templ SessionSaved(exercises []domain.SessionExercise,completedSets int) {
	@SaveStatus()
	@SessionSetCount(completedSets,true)
	for _, e := range exercises {
		if e.Format == "emom" {
			@EMOMSummary(e,true)
		}
	}
}

templ SessionSetCount(count int,outOfBand bool) {
	if outOfBand {
		<span id="session-set-count" class="session-set-count" hx-swap-oob="true">{ fmt.Sprintf("%d sets done",count) }</span>
	} else {
		<span id="session-set-count" class="session-set-count">{ fmt.Sprintf("%d sets done",count) }</span>
	}
}

templ SaveStatus() { <span id="save-status" class="save-status saved">Saved just now</span> }

templ DateFilter(from,to string) { <form class="date-filter" method="get"><label>From<input type="date" name="from" value={ from }/></label><label>To<input type="date" name="to" value={ to }/></label><button class="button secondary">Update</button></form> }

templ ExerciseSummaryTable(items []domain.ExerciseSummary,from,to string) {
	if len(items) == 0 {
		@EmptyState("No exercise data","Complete a session in this period to see exercise progress.") {}
	} else {
		<div class="table-wrap"><table><thead><tr><th>Exercise</th><th>Sessions</th><th>Sets</th><th>Total reps</th><th>Progress metric</th><th></th></tr></thead><tbody>
			for _, x := range items {
				<tr><td><strong>{ x.Exercise.Name }</strong><small class="summary-mode">{ x.Exercise.Mode }
					if x.Exercise.Archived {
						<span class="pill">Archived</span>
					}
				</small></td><td>{ fmt.Sprintf("%d",x.Sessions) }</td><td>{ fmt.Sprintf("%d",x.Sets) }</td><td>{ fmt.Sprintf("%d",x.TotalReps) }</td><td>
					if x.Exercise.Mode == "weighted" {
						<strong>{ number(x.Volume) }</strong><small> kg·reps</small>
					} else {
						<strong>{ fmt.Sprintf("%d",x.TotalReps) }</strong><small> reps</small>
					}
				</td><td><a href={ templ.SafeURL(fmt.Sprintf("/analytics/exercises/%d?from=%s&to=%s",x.Exercise.ID,from,to)) }>View trend</a></td></tr>
			}
		</tbody></table></div>
	}
}

templ AnalyticsPage(a domain.AnalyticsOverview) {
	@Layout("Analytics") {
		@PageHeader("Training analytics","Exercise progress","Compare each exercise across every routine without mixing unrelated training volume.") { @DateFilter(inputDate(a.From),inputDate(a.To)) }
		<section><div class="section-title"><h2>Exercises</h2><span>{ fmt.Sprintf("%d with completed work",len(a.Exercises)) }</span></div>@ExerciseSummaryTable(a.Exercises,inputDate(a.From),inputDate(a.To))</section>
	}
}
templ Chart(points []domain.ChartPoint,label string) {
	<div class="chart" role="img" aria-label={ label }>
		if len(points) == 0 {
			<p class="muted">Complete sessions to see a trend.</p>
		} else {
			<svg viewBox="0 0 600 210" preserveAspectRatio="none" aria-hidden="true"><line x1="20" y1="180" x2="580" y2="180"></line><polyline points={ chartPoints(points) }></polyline>
				for i, p := range points {
					<circle cx={ chartX(i,len(points)) } cy={ chartY(points,p.Value) } r="5"><title>{ p.Label }: { number(p.Value) }</title></circle>
				}
			</svg><div class="chart-labels"><span>{ points[0].Label }</span><span>{ points[len(points)-1].Label }</span></div>
		}
	</div>
}

templ RoutineAnalyticsPage(a domain.RoutineAnalytics) {
	@Layout("Routine progress") { <a class="back" href={ templ.SafeURL(fmt.Sprintf("/routines/%d",a.Routine.ID)) }>← { a.Routine.Name }</a>@PageHeader("Routine analytics",a.Routine.Name,"Completion consistency and exercise-specific training work over the selected period.") { @DateFilter(inputDate(a.From),inputDate(a.To)) }<div class="metric-grid"><div class="metric accent"><span>Sessions</span><strong>{ fmt.Sprintf("%d",a.Sessions) }</strong><small>{ fmt.Sprintf("%.1f per week",a.SessionsPerWeek) }</small></div><div class="metric"><span>Exercises</span><strong>{ fmt.Sprintf("%d",len(a.Exercises)) }</strong><small>with completed work</small></div><div class="metric"><span>Completed work</span><strong>{ fmt.Sprintf("%d",a.Reps) }</strong><small>{ fmt.Sprintf("%d sets",a.Sets) }</small></div><div class="metric"><span>Longest gap</span><strong>{ fmt.Sprintf("%d",a.LongestGapDays) }</strong><small>days</small></div></div><section class="panel chart-panel"><div class="section-title"><h2>Session trend</h2><span>{ date(a.From) } – { date(a.To) }</span></div>@Chart(a.Points,"Completed sessions over time")</section><section><div class="section-title"><h2>Work by exercise</h2><span>Volume stays exercise-specific</span></div>@ExerciseSummaryTable(a.Exercises,inputDate(a.From),inputDate(a.To))</section> }
}

templ ExerciseAnalyticsPage(a domain.ExerciseAnalytics) {
	@Layout("Exercise progress") {
		<a class="back" href="/exercises">← Exercise library</a>
		@PageHeader(a.Exercise.Mode+" exercise",a.Exercise.Name,"Progress across every routine using this shared exercise.") { @DateFilter(inputDate(a.From),inputDate(a.To)) }
		<div class="metric-grid"><div class="metric accent"><span>Sessions</span><strong>{ fmt.Sprintf("%d",a.Sessions) }</strong><small>training exposures</small></div><div class="metric"><span>Total reps</span><strong>{ fmt.Sprintf("%d",a.TotalReps) }</strong><small>completed reps</small></div>
			if a.Exercise.Mode == "weighted" {
				<div class="metric"><span>Volume</span><strong>{ number(a.Volume) }</strong><small>kg·reps</small></div><div class="metric"><span>Best / e1RM</span><strong>{ number(a.BestWeight) }</strong><small>{ number(a.Estimated1RM) } kg estimated</small></div>
			} else {
				<div class="metric"><span>Best set</span><strong>{ fmt.Sprintf("%d",a.BestSetReps) }</strong><small>reps</small></div>
			}
		</div><section class="panel chart-panel"><div class="section-title"><h2>{ exerciseMetric(a.Exercise.Mode) } trend</h2><span>{ date(a.From) } – { date(a.To) }</span></div>@Chart(a.Points,"Exercise performance over time")</section>
	}
}

templ AboutPage() { @Layout("About") { @PageHeader("Local-first","About Tempo","A deliberately simple personal fitness tracker.") {} <section class="prose panel"><h2>Built for the work</h2><p>Tempo stores your routines and training history in your own local PostgreSQL database. There are no accounts, feeds, or cloud dependencies beyond loading the small HTMX browser library.</p><p>Weights are recorded in kilograms. Estimated one-rep max uses the Epley formula and should be treated as a training estimate.</p></section> } }
templ ErrorPage(status int,message string) { @Layout("Something went wrong") { @EmptyState(fmt.Sprintf("Error %d",status),message) { <a class="button primary" href="/">Return home</a> } } }
